# Copy this file to .env and fill in real values.
# .env is git-ignored; .env.example is committed as a template.
#
# The variables below are placeholders. Replace them once the stack and the
# project's actual configuration are decided.

# Runtime environment: development | test | production
APP_ENV=development

# Base URL the app is served from.
APP_URL=http://localhost:3000

# Example database connection string.
# DATABASE_URL=

# Example third-party API key. Never commit the real value.
# API_KEY=
